    "Connect an email account and OTP Buddy will catch one-time codes as they arrive — ready to copy in one click.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an email account and OTP Buddy will catch one-time codes as they arrive — ready to copy in one click."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie ein E-Mail-Konto — OTP Buddy fängt Einmal-Codes ab, bereit zum Kopieren mit einem Klick."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel een e-mailaccount en OTP Buddy vangt eenmalige codes op — klaar om met één klik te kopiëren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue uma conta de e-mail e o OTP Buddy apanha códigos de uso único — prontos a copiar com um clique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una cuenta de correo y OTP Buddy capturará códigos de un solo uso — listos para copiar en un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un compte e-mail et OTP Buddy attrapera les codes à usage unique — prêts à copier en un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un account e-mail e OTP Buddy cattura i codici monouso — pronti da copiare con un clic."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط حساب بريد ويلتقط OTP Buddy الرموز لمرة واحدة فور وصولها — جاهزة للنسخ بنقرة."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连接邮箱后，OTP Buddy 会在验证码到达时捕获——一键即可复制。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите почту — OTP Buddy поймает одноразовые коды и даст скопировать одним кликом."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアカウントを接続すると、ワンタイムコードを受け取った瞬間にキャッチ。ワンクリックでコピーできます。"
          }
        }
      },
      "extractionState": "manual"
    },
