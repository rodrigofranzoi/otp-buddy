    "Optional — leave blank to use your email as the title.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — leave blank to use your email as the title."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional — leer lassen, um die E-Mail-Adresse als Titel zu verwenden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel — laat leeg om je e-mailadres als titel te gebruiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — deixe em branco para usar o e-mail como título."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional — déjalo en blanco para usar el correo como título."
          }
        },
        "fr": {
